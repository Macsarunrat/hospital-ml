# ============================================================
# Hospital ML Configuration Template (คัดลอกไปใส่ในไฟล์ .env)
# ============================================================

# 1. เลือกรหัสงานที่ต้องการเทรนบน Kaggle:
#    - "rice"       : เทรนน้ำหนักถ้วยข้าว (EfficientNetB0 Regression)
#    - "before"     : เทรนตรวจจับอาหารเต็มถาด (YOLOv8s-seg)
#    - "after_yolo" : เทรนตีกรอบถ้วยหลังทาน (YOLOv8n Detection)
#    - "after_reg"  : เทรนน้ำหนักถ้วยหลังทาน (EfficientNetB0 Regression)
TASK="rice"

# 2. รหัส Token สำหรับอ่าน GitHub Private Repo (ถ้า Repo เป็น Public ไม่ต้องใส่)
GITHUB_TOKEN=""

# 3. รหัส API Key สำหรับดูกราฟบน WandB Dashboard
WANDB_API_KEY=""
