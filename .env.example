# ============================================================
# Hospital ML - Environment Configuration Template
# คัดลอกไฟล์นี้เป็น '.env' แล้วแก้ไขค่าตามที่ต้องการใช้งาน
# ============================================================

# 1. รหัสงานที่ต้องการรัน (Task Configuration)
# ตัวเลือก: rice | before | after_yolo | after_reg
TASK=rice

# 2. โมเดล Backbone สำหรับ Rice Regression
# ตัวเลือก: EfficientNetB0 | EfficientNetB1 | EfficientNetB2 | EfficientNetB3
BACKBONE=EfficientNetB1

# 3. GitHub Personal Access Token (สำหรับโคลน repo บน Kaggle อัตโนมัติ)
# หากเป็น repo สาธารณะหรือรันในเครื่องตัวเอง ไม่จำเป็นต้องระบุ
GITHUB_TOKEN=

# 4. Weights & Biases API Key (สำหรับบันทึกผล Training Graphs & Metrics)
# หากใส่ไว้ใน Kaggle Dataset 'hospital-secrets/.env' อยู่แล้ว หรือไม่ต้องการใช้ WandB สามารถเว้นว่างไว้ได้
WANDB_API_KEY=
